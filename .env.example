# Copy this file to .env (which is git-ignored) and fill in your values.
# Load it into your shell before running bundle or dbt commands:
#   set -a; source .env; set +a

# Profile name from ~/.databrickscfg; the CLI takes the workspace host from it.
DATABRICKS_CONFIG_PROFILE=your-profile

# Where tables and the Volume are created (used by the bundle and by dbt).
BUNDLE_VAR_catalog=your_catalog
BUNDLE_VAR_schema=your_schema

# SQL warehouse ID for the dbt task in the scheduled job
# (SQL Warehouses > your warehouse, or: databricks warehouses list).
BUNDLE_VAR_warehouse_id=your-warehouse-id

# dbt connection for local runs (SQL Warehouses > your warehouse > Connection details).
# Host WITHOUT https://
DBT_DATABRICKS_HOST=your-workspace.cloud.databricks.com
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
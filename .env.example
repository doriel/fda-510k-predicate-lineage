# Copy this file to .env (which is git-ignored) and fill in your values.
# Load it into your shell before running bundle commands:
#   set -a; source .env; set +a

# Profile name from ~/.databrickscfg; the CLI takes the workspace host from it.
DATABRICKS_CONFIG_PROFILE=your-profile

# Where tables and the Volume are created.
BUNDLE_VAR_catalog=your_catalog
BUNDLE_VAR_schema=your_schema

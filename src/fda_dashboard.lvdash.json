{
  "datasets": [
    {
      "displayName": "kpis",
      "name": "157d6818",
      "queryLines": [
        "select\r\n",
        "  max(if(metric = 'documents_extracted', numerator, null)) as documents_extracted,\r\n",
        "  round(max(if(metric = 'citations_in_graph', rate, null)) * 100, 1) as pct_citations_resolved,\r\n",
        "  max(if(metric = 'edges', numerator, null)) as edges,\r\n",
        "  max(if(metric = 'name_matches_wrong', numerator, null)) as name_matches_wrong\r\n",
        "from\r\n",
        "fda_mart_extraction_quality"
      ]
    },
    {
      "displayName": "coverage",
      "name": "b3496ce3",
      "queryLines": [
        "select\r\n",
        "    case metric\r\n",
        "        when 'pdfs_downloaded'         then '1. PDFs downloaded'\r\n",
        "        when 'documents_parsed'        then '2. Parsed'\r\n",
        "        when 'documents_extracted'     then '3. Extracted'\r\n",
        "        when 'devices_with_predicates' then '4. With predicates in graph'\r\n",
        "    end as step,\r\n",
        "    numerator as documents\r\n",
        "from fda_mart_extraction_quality\r\n",
        "where metric in ('pdfs_downloaded', 'documents_parsed', 'documents_extracted', 'devices_with_predicates')\r\n",
        "union all\r\n",
        "select '0. Download attempts', denominator\r\n",
        "from fda_mart_extraction_quality\r\n",
        "where metric = 'pdfs_downloaded'"
      ]
    },
    {
      "displayName": "resolution",
      "name": "134cff90",
      "queryLines": [
        "select replace(metric, 'citations_', '') as resolution_status, numerator as citations\r\n",
        "from fda_mart_extraction_quality\r\n",
        "where metric_group = 'resolution'\r\n",
        "  and metric <> 'citations_in_graph'"
      ]
    },
    {
      "displayName": "edges",
      "name": "d3a20236",
      "queryLines": [
        "with sample_codes as (\n",
        "    select distinct o.product_code\n",
        "    from fda_stg_pdf_files as f\n",
        "    join fda_stg_openfda__submissions as o\n",
        "        on o.k_number = f.k_number\n",
        ")\n",
        "select\n",
        "    e.subject_k_number,\n",
        "    e.predicate_k_number,\n",
        "    e.resolution_method,\n",
        "    e.was_repaired,\n",
        "    cast(year(e.subject_decision_date) as string) as subject_year,\n",
        "    round(e.predicate_age_days / 365.25, 1)       as predicate_age_years,\n",
        "    s.device_name                                 as subject_device,\n",
        "    s.applicant                                   as subject_applicant,\n",
        "    p.device_name                                 as predicate_device,\n",
        "    p.applicant                                   as predicate_applicant,\n",
        "    p.product_code                                as predicate_product_code,\n",
        "    sc.product_code is not null                   as predicate_in_sample_codes,\n",
        "    if(sc.product_code is not null,\n",
        "       'Same product codes as the sample',\n",
        "       'Other product codes')                     as predicate_origin\n",
        "from fda_fct_predicate_edge as e\n",
        "join fda_stg_openfda__submissions as s\n",
        "    on s.k_number = e.subject_k_number\n",
        "join fda_stg_openfda__submissions as p\n",
        "    on p.k_number = e.predicate_k_number\n",
        "left join sample_codes as sc\n",
        "    on sc.product_code = p.product_code\n"
      ]
    },
    {
      "displayName": "top_predicates",
      "name": "a6c9b867",
      "queryLines": [
        "select\r\n",
        "    e.predicate_k_number,\r\n",
        "    p.device_name,\r\n",
        "    p.applicant,\r\n",
        "    year(p.decision_date)            as cleared_year,\r\n",
        "    count(distinct e.subject_k_number) as cited_by\r\n",
        "from fda_fct_predicate_edge as e\r\n",
        "join fda_stg_openfda__submissions as p\r\n",
        "    on p.k_number = e.predicate_k_number\r\n",
        "group by all\r\n",
        "order by cited_by desc\r\n",
        "limit 15"
      ]
    },
    {
      "displayName": "predicate_age",
      "name": "1fdc9152",
      "queryLines": [
        "select\r\n",
        "    concat(lpad(cast(floor(predicate_age_days / 365.25 / 5) * 5 as string), 2, '0'),\r\n",
        "           '-',\r\n",
        "           lpad(cast(floor(predicate_age_days / 365.25 / 5) * 5 + 4 as string), 2, '0'))\r\n",
        "        as age_years,\r\n",
        "    count(*) as edges\r\n",
        "from fda_fct_predicate_edge\r\n",
        "group by 1\r\n",
        "order by 1"
      ]
    }
  ],
